# Firebase Configuration for Nexalus Innovations LLP
# Replace with your Firebase Project settings from Firebase Console:
# Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=nexalus-innovations.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nexalus-innovations
VITE_FIREBASE_STORAGE_BUCKET=nexalus-innovations.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
